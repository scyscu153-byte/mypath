# ─────────────────────────────────────────────
#  환경변수 템플릿
#
#  사용법:
#    1. 이 파일을 .env 로 복사한다
#         cp .env.example .env
#    2. .env 에 실제 값을 채운다
#    3. .env 는 .gitignore 에 등록되어 있어 커밋되지 않는다
#
#  ⚠️ 절대 이 파일(.env.example)에 실제 키를 적지 마세요.
#     이 파일은 저장소에 공개됩니다.
# ─────────────────────────────────────────────

# 팩트챗 게이트웨이 API 키
# 발급: 명지전문대 팩트챗(mjc.factchat.bot) → API Gateway
VITE_FACTCHAT_API_KEY=여기에_본인_키를_입력

# 게이트웨이 주소 (변경할 일 없음)
VITE_FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# 데모 모드용 키 (선택)
# 심사위원이 키 없이 체험할 수 있도록 하려면 설정.
# 설정하지 않으면 데모 모드는 비활성화된다.
VITE_DEMO_API_KEY=
